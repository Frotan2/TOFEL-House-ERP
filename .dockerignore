# Build context allowlist for product/app.Dockerfile (context = repository root).
# Only the owned apps, the canonical Owner decision ledger, and product
# entrypoint files enter the image; this keeps .git, other docs, tests and above
# all product/data/ (live site data, backups and secrets) out of the context.
*
!apps/
!docs/
docs/*
!docs/owner-decisions.json
!product/app.Dockerfile
!product/bootstrap.py
!product/activate.py
!product/restore.py
!product/backup.py
!product/native_gpg.py
!product/native_db.py
!product/wsgi.py
!product/web.cjs
!product/realtime.cjs
!product/entrypoint.sh
!product/perf_baseline.py
# Signed update engine plus its container entrypoint (the customer image
# verifies and migrates releases; nothing is built on the Windows PC).
!product/update_engine.py
!product/update_host.py
!product/update_entrypoint.sh
!tools/
tools/*
!tools/foundation/
tools/foundation/*
!tools/foundation/secure_weasyprint.py
!tools/foundation/secure_frappe_python.py
!tools/foundation/secure_hrms.py
!tools/foundation/hrms-locks/
!tools/foundation/hrms-locks/**
!tools/foundation/banking-locks/
!tools/foundation/banking-locks/**
!tools/foundation/secure_realtime.py
!tools/foundation/realtime-locks/
!tools/foundation/realtime-locks/**
!tools/foundation/secure_markdown.py
!tools/foundation/secure_deepmerge.py
!tools/foundation/deepmerge-hashes.json
!tools/foundation/fix_setup_sidebar.py
**/__pycache__
**/*.pyc
