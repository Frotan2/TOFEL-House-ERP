{
  "doctype": "DocType",
  "name": "TH Placement Response",
  "module": "Placement",
  "autoname": "hash",
  "engine": "InnoDB",
  "allow_rename": 0,
  "track_changes": 0,
  "field_order": [
    "attempt",
    "occurrence",
    "revision",
    "option_id",
    "missing",
    "synthetic"
  ],
  "fields": [
    {
      "fieldname": "attempt",
      "label": "Attempt",
      "fieldtype": "Link",
      "reqd": 1,
      "options": "TH Placement Attempt"
    },
    {
      "fieldname": "occurrence",
      "label": "Occurrence",
      "fieldtype": "Int",
      "reqd": 1
    },
    {
      "fieldname": "revision",
      "label": "Revision",
      "fieldtype": "Int",
      "reqd": 1
    },
    {
      "fieldname": "option_id",
      "label": "Option Id",
      "fieldtype": "Data"
    },
    {
      "fieldname": "missing",
      "label": "Missing",
      "fieldtype": "Check",
      "default": "0"
    },
    {
      "fieldname": "synthetic",
      "label": "Synthetic",
      "fieldtype": "Check",
      "default": "1",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "Placement Publisher",
      "read": 1,
      "select": 1
    },
    {
      "role": "Placement Auditor",
      "read": 1,
      "select": 1
    },
    {
      "role": "Placement Invigilator",
      "read": 1,
      "select": 1
    },
    {
      "role": "Placement Assessor",
      "read": 1,
      "select": 1
    },
    {
      "role": "Placement Reviewer",
      "read": 1,
      "select": 1
    },
    {
      "role": "Placement Releaser",
      "read": 1,
      "select": 1
    }
  ],
  "sort_field": "creation",
  "sort_order": "DESC"
}
