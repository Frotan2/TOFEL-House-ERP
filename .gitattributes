# All text files materialize with LF by default, independent of core.autocrlf.
# This covers every owned application source and every text file copied into
# the Linux product image. Binary files remain byte-for-byte unchanged.
* text=auto eol=lf

# Windows cmd.exe scripts are the deliberate exception: CRLF is required for
# its multi-line parser on real Windows Git checkouts. Their syntax also stays
# LF-safe for GitHub ZIP delivery (no multi-line command blocks).
*.cmd text eol=crlf
*.bat text eol=crlf

# Keep the Linux entrypoint and Docker context control file explicit: a CR
# before the shebang newline breaks the kernel's /bin/sh lookup, and a CR on
# a .dockerignore rule changes the build allowlist.
*.sh text eol=lf
.dockerignore text eol=lf

# The product build context is an allowlist. All text in the owned apps and
# product Python scripts must be LF even in fresh Windows checkouts.
apps/** text=auto eol=lf
product/*.py text eol=lf
product/app.Dockerfile text eol=lf
product/docker-compose.yml text eol=lf

# This includes directly executed product/activate.py and perf_baseline.py.
# Git attributes govern future checkouts; they do not rewrite an existing
# stale worktree, which the Windows installer/Repair flow normalizes first.
