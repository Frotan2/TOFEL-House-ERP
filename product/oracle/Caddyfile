{
	admin off
	default_sni {$PUBLIC_ADDRESS}
}

{$PUBLIC_ADDRESS} {
	encode zstd gzip
	tls {
		issuer acme {
			profile shortlived
		}
	}
	header {
		Strict-Transport-Security "max-age=86400"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}
	reverse_proxy web:8000
}
